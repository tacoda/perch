<div class="lens" id="<%= dom_id(lens) %>">
  <%= link_to image_tag(lens.image), lens, data: { turbo_frame: "_top" } %>
  <div class="name">
    <%= link_to lens.name, lens, data: { turbo_frame: "_top" } %>
  </div>
  <div class="category">
    <%= lens.category %>
  </div>
  <div class="popularity" id="<%= dom_id(lens, :popularity) %>">
    <%= lens.field_kit_items_count %>
  </div>
  <% if signed_in? %>
    <%= render "lenses/field_kit_button", lens: lens %>
  <% end %>
</div>
